# Neon PostgreSQL (provisioned via `vercel integration add neon` or Neon Console)
DATABASE_URL=

# Clerk Authentication (provisioned via `vercel integration add clerk` or Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Strict Founder Allowlist (comma-separated, case-insensitive; fail-closed if empty)
ALLOWED_FOUNDER_EMAILS=tim@committedcitizens.co.uk,ben@committedcitizens.co.uk

# Folk CRM API (Settings -> API in app.folk.app)
FOLK_API_KEY=
FOLK_API_BASE_URL=https://api.folk.app/v1

# Base URL for local development
APP_URL=http://localhost:3000
